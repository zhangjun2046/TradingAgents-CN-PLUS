# ============================================
# Render平台环境变量配置示例
# TradingAgents-CN v1.0.0-preview
# ============================================
# 
# 使用说明：
# 1. 在Render Dashboard中创建Web Service后
# 2. 进入"Environment"标签页
# 3. 根据本文件配置环境变量
# 4. 必需的变量请务必设置，可选的变量根据需要设置
#
# ============================================

# ============================================
# 【必需】OpenAI API配置
# ============================================
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API基础URL（可选，使用代理或第三方服务时设置）
# OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI模型选择（可选，默认使用gpt-4）
# OPENAI_MODEL=gpt-4
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# 【推荐】Tushare数据源配置
# ============================================
# Tushare是A股数据的主要来源，建议配置
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=your-tushare-token-here

# ============================================
# 【自动配置】数据库连接（容器内部）
# ============================================
# 以下配置已在render.yaml中设置，无需手动配置
# TRADINGAGENTS_MONGODB_URL=mongodb://localhost:27017/tradingagents
# TRADINGAGENTS_REDIS_URL=redis://localhost:6379
# TRADINGAGENTS_CACHE_TYPE=redis

# ============================================
# 【自动配置】API服务配置
# ============================================
# 以下配置已在render.yaml中设置，无需手动配置
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=*

# ============================================
# 【自动配置】日志配置
# ============================================
# 以下配置已在render.yaml中设置，无需手动配置
# TRADINGAGENTS_LOG_LEVEL=WARNING
# TRADINGAGENTS_LOG_DIR=/app/logs
# TRADINGAGENTS_LOG_FILE=/app/logs/tradingagents.log

# ============================================
# 【可选】Google AI配置
# ============================================
# 获取地址: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# Google AI基础URL（可选）
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com

# ============================================
# 【可选】Anthropic Claude配置
# ============================================
# 获取地址: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# 【可选】DeepSeek配置
# ============================================
# 获取地址: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_API_BASE=https://api.deepseek.com

# ============================================
# 【可选】阿里云通义千问配置
# ============================================
# 获取地址: https://dashscope.console.aliyun.com/
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ============================================
# 【可选】其他数据源配置
# ============================================

# AkShare数据源（默认启用）
# AKSHARE_ENABLED=true

# BaoStock数据源（默认启用）
# BAOSTOCK_ENABLED=true

# ============================================
# 【可选】系统配置
# ============================================

# 最大并发分析任务数（默认3，免费套餐建议设为1）
# MAX_CONCURRENT_TASKS=1

# 默认分析深度（1-3，默认2）
# DEFAULT_RESEARCH_DEPTH=2

# 启用实时PE/PB计算（默认true）
# ENABLE_REALTIME_PE_PB=true

# ============================================
# 【高级】性能优化配置
# ============================================

# Uvicorn Worker数量（免费套餐固定为1）
# UVICORN_WORKERS=1

# 日志级别（DEBUG/INFO/WARNING/ERROR，免费套餐建议WARNING）
# LOG_LEVEL=WARNING

# 禁用后台定时任务（免费套餐建议禁用，节省资源）
# DISABLE_BACKGROUND_TASKS=true

# ============================================
# 配置检查清单
# ============================================
# 
# 部署前请确认：
# ✅ OPENAI_API_KEY 已设置（必需）
# ✅ TUSHARE_TOKEN 已设置（推荐）
# ✅ 其他LLM API密钥根据需要设置（可选）
# ✅ 数据库配置保持默认（自动配置）
# ✅ 日志级别设为WARNING（节省资源）
#
# ============================================

